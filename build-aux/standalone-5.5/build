#
# The build script of a standalone smush on Lua 5.5.1, for the CI of the
# host: compile the host, the runtime and Lua into the program OUT (see
# Standalone Programs in doc/smush.md).

lua_c=[
    lapi lauxlib lbaselib lcode lcorolib lctype ldblib ldebug ldo
    ldump lfunc lgc linit liolib llex lmathlib lmem loadlib lobject
    lopcodes loslib lparser lstate lstring lstrlib ltable ltablib ltm
    lundump lutf8lib lvm lzio
]

$CC $CFLAGS -DLUA_USE_POSIX -Ilua -o $OUT main.c data.c \
    lua/$lua_c.c $LDFLAGS $LIBS
