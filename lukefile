luke_format = 0

package  = 'smush'
version  = '$USER/$gitref'

-- LuaRocks builds smush from the rockspec, which is how `luke release`
-- builds it too, so what is left is for `luke release`: it adds the release
-- to NEWS.md, writes the release rockspec, points the README badges at the
-- release branch, commits the single file that the rock installs, and
-- publishes the manual to gh-pages.
release = {
   news               = 'NEWS.md',
   rockspec           = 'smush-dev-1.rockspec',
   check_dependencies = true,
   add                = {'build-aux/smush'},
   replacements       = {
      {['README.md']  = {
         {['?branch=master'] = '?branch=release-v@version@'},
      }},
   },
   -- The Jekyll site and the `_config.yml.in` that is filled with the
   -- release number are on the gh-pages branch.
   ['gh-pages']       = {
      {['index.md'] = 'doc/smush.md'},
      '_config.yml.in',
   },
}
